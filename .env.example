# Environment Configuration for narrative-audit-jev
# For offline evaluation, unit testing, and deterministic CI, NO API KEYS ARE REQUIRED.

# Optional: OpenRouter API Configuration (used for external multi-model benchmarking)
# OPENROUTER_API_KEY=your_openrouter_api_key_here
# OPENROUTER_MODEL_1=deepseek/deepseek-v4.1-flash
# OPENROUTER_MODEL_2=qwen/qwen3.7-flash
# OPENROUTER_MODEL_3=perplexity/pplx-decider-flash-v1.2
# OPENROUTER_REQUEST_DELAY_SEC=1.0

# Optional: LLM Provider API Keys (used for live agent execution if offline mock is disabled)
# OPENAI_API_KEY=your_openai_api_key_here
# ANTHROPIC_API_KEY=your_anthropic_api_key_here
# GEMINI_API_KEY=your_gemini_api_key_here

# Runtime settings
ENVIRONMENT=development
LOG_LEVEL=INFO
OFFLINE_MODE=true
SEC_EDGAR_USER_AGENT=ResearchProject admin@example.com
